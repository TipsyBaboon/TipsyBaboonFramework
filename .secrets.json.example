{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "description": "Local secrets for TipsyBaboon development. Copy to .secrets.json and populate with real values.",
  
  "NuGet": {
    "NuGetOrg": {
      "ApiKey": "oy2_YourNuGetOrgApiKeyHere",
      "Note": "For publishing to nuget.org - or use: dotnet nuget push --api-key $env:NUGET_API_KEY"
    }
  },
  
  "OAuth": {
    "Google": {
      "ClientId": "YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR-GOOGLE-CLIENT-SECRET"
    },
    "Microsoft": {
      "ClientId": "YOUR-MICROSOFT-CLIENT-ID",
      "ClientSecret": "YOUR-MICROSOFT-CLIENT-SECRET"
    }
  },
  
  "Database": {
    "TipsyBaboonCore": "Server=localhost;Database=YourDatabase;Trusted_Connection=True;TrustServerCertificate=True;",
    "Note": "Override connection strings for local development"
  },
  
  "AI": {
    "OllamaEndpoint": "http://localhost:11434",
    "ModelName": "llama3.1:8b"
  }
}
