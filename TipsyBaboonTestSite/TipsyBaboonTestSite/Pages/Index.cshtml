@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h1>TipsyBaboon Test Site</h1>
            <p class="lead">Development and testing environment</p>
            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-page="/BootstrapTest" class="btn btn-primary">
                                <i class="fas fa-palette me-2"></i>
                                Bootstrap Component Test
                            </a>
                            <p class="text-muted small mt-1 mb-0">View all Bootstrap 5 components and color variants for styling reference</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


