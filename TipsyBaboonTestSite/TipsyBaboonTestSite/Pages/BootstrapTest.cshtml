@page
@model TipsyBaboonTestSite.Pages.BootstrapTestModel
@{
    ViewData["Title"] = "Bootstrap Component Test";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">Bootstrap 5 Component Test Page</h1>
    <p class="lead">Comprehensive showcase of all Bootstrap components and variants for styling reference.</p>

    <div class="accordion" id="componentAccordion">

        <!-- Colors & Typography -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#colorsTypography">
                    Colors & Typography
                </button>
            </h2>
            <div id="colorsTypography" class="accordion-collapse collapse show" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <h3>Theme Colors</h3>
                    <div class="row mb-4">
                        <div class="col-md-2"><div class="p-3 bg-primary text-white">Primary</div></div>
                        <div class="col-md-2"><div class="p-3 bg-secondary text-white">Secondary</div></div>
                        <div class="col-md-2"><div class="p-3 bg-success text-white">Success</div></div>
                        <div class="col-md-2"><div class="p-3 bg-danger text-white">Danger</div></div>
                        <div class="col-md-2"><div class="p-3 bg-warning text-dark">Warning</div></div>
                        <div class="col-md-2"><div class="p-3 bg-info text-dark">Info</div></div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-2"><div class="p-3 bg-light text-dark border">Light</div></div>
                        <div class="col-md-2"><div class="p-3 bg-dark text-white">Dark</div></div>
                        <div class="col-md-2"><div class="p-3 bg-white text-dark border">White</div></div>
                        <div class="col-md-2"><div class="p-3 bg-transparent text-dark border">Transparent</div></div>
                    </div>

                    <h3>Typography</h3>
                    <h1>Heading 1</h1>
                    <h2>Heading 2</h2>
                    <h3>Heading 3</h3>
                    <h4>Heading 4</h4>
                    <h5>Heading 5</h5>
                    <h6>Heading 6</h6>
                    <p class="lead">Lead paragraph text - used for emphasis</p>
                    <p>Regular paragraph text with <strong>bold</strong>, <em>italic</em>, <u>underline</u>, <small>small</small>, <mark>marked</mark>, and <del>deleted</del> text.</p>
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#buttons">
                    Buttons
                </button>
            </h2>
            <div id="buttons" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <h3>Solid Buttons</h3>
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary">Primary</button>
                        <button type="button" class="btn btn-secondary">Secondary</button>
                        <button type="button" class="btn btn-success">Success</button>
                        <button type="button" class="btn btn-danger">Danger</button>
                        <button type="button" class="btn btn-warning">Warning</button>
                        <button type="button" class="btn btn-info">Info</button>
                        <button type="button" class="btn btn-light">Light</button>
                        <button type="button" class="btn btn-dark">Dark</button>
                        <button type="button" class="btn btn-link">Link</button>
                    </div>

                    <h3>Outline Buttons</h3>
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-primary">Primary</button>
                        <button type="button" class="btn btn-outline-secondary">Secondary</button>
                        <button type="button" class="btn btn-outline-success">Success</button>
                        <button type="button" class="btn btn-outline-danger">Danger</button>
                        <button type="button" class="btn btn-outline-warning">Warning</button>
                        <button type="button" class="btn btn-outline-info">Info</button>
                        <button type="button" class="btn btn-outline-light">Light</button>
                        <button type="button" class="btn btn-outline-dark">Dark</button>
                    </div>

                    <h3>Button Sizes</h3>
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary btn-lg">Large</button>
                        <button type="button" class="btn btn-primary">Default</button>
                        <button type="button" class="btn btn-primary btn-sm">Small</button>
                    </div>

                    <h3>Button States</h3>
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary">Normal</button>
                        <button type="button" class="btn btn-primary active">Active</button>
                        <button type="button" class="btn btn-primary" disabled>Disabled</button>
                        <button type="button" class="btn btn-primary">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Loading
                        </button>
                    </div>

                    <h3>Button Groups</h3>
                    <div class="btn-group mb-3" role="group">
                        <button type="button" class="btn btn-primary">Left</button>
                        <button type="button" class="btn btn-primary">Middle</button>
                        <button type="button" class="btn btn-primary">Right</button>
                    </div>
                    <div class="btn-group mb-3" role="group">
                        <button type="button" class="btn btn-outline-secondary">Left</button>
                        <button type="button" class="btn btn-outline-secondary active">Active</button>
                        <button type="button" class="btn btn-outline-secondary">Right</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerts -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#alerts">
                    Alerts
                </button>
            </h2>
            <div id="alerts" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <div class="alert alert-primary" role="alert">Primary alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-secondary" role="alert">Secondary alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-success" role="alert">Success alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-danger" role="alert">Danger alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-warning" role="alert">Warning alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-info" role="alert">Info alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-light" role="alert">Light alert with <a href="#" class="alert-link">link</a></div>
                    <div class="alert alert-dark" role="alert">Dark alert with <a href="#" class="alert-link">link</a></div>
                    
                    <h3>Dismissible Alert</h3>
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong>Warning!</strong> This is a dismissible alert.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Badges -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#badges">
                    Badges
                </button>
            </h2>
            <div id="badges" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <h3>Standard Badges</h3>
                    <div class="mb-3">
                        <span class="badge bg-primary">Primary</span>
                        <span class="badge bg-secondary">Secondary</span>
                        <span class="badge bg-success">Success</span>
                        <span class="badge bg-danger">Danger</span>
                        <span class="badge bg-warning text-dark">Warning</span>
                        <span class="badge bg-info text-dark">Info</span>
                        <span class="badge bg-light text-dark">Light</span>
                        <span class="badge bg-dark">Dark</span>
                    </div>

                    <h3>Pill Badges</h3>
                    <div class="mb-3">
                        <span class="badge rounded-pill bg-primary">Primary</span>
                        <span class="badge rounded-pill bg-secondary">Secondary</span>
                        <span class="badge rounded-pill bg-success">Success</span>
                        <span class="badge rounded-pill bg-danger">Danger</span>
                        <span class="badge rounded-pill bg-warning text-dark">Warning</span>
                        <span class="badge rounded-pill bg-info text-dark">Info</span>
                    </div>

                    <h3>Badges in Context</h3>
                    <button type="button" class="btn btn-primary">
                        Notifications <span class="badge bg-danger">9</span>
                    </button>
                    <button type="button" class="btn btn-secondary">
                        Messages <span class="badge bg-light text-dark">4</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Forms -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#forms">
                    Form Elements
                </button>
            </h2>
            <div id="forms" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <form>
                        <h3>Text Inputs</h3>
                        <div class="mb-3">
                            <label for="textInput" class="form-label">Text Input</label>
                            <input type="text" class="form-control" id="textInput" placeholder="Enter text">
                        </div>
                        <div class="mb-3">
                            <label for="emailInput" class="form-label">Email</label>
                            <input type="email" class="form-control" id="emailInput" placeholder="name@example.com">
                        </div>
                        <div class="mb-3">
                            <label for="passwordInput" class="form-label">Password</label>
                            <input type="password" class="form-control" id="passwordInput">
                        </div>
                        <div class="mb-3">
                            <label for="disabledInput" class="form-label">Disabled Input</label>
                            <input type="text" class="form-control" id="disabledInput" disabled value="Disabled">
                        </div>
                        <div class="mb-3">
                            <label for="readonlyInput" class="form-label">Readonly Input</label>
                            <input type="text" class="form-control" id="readonlyInput" readonly value="Readonly">
                        </div>

                        <h3>Input Sizes</h3>
                        <div class="mb-3">
                            <input type="text" class="form-control form-control-lg" placeholder="Large">
                            <input type="text" class="form-control mt-2" placeholder="Default">
                            <input type="text" class="form-control form-control-sm mt-2" placeholder="Small">
                        </div>

                        <h3>Validation States</h3>
                        <div class="mb-3">
                            <label for="validInput" class="form-label">Valid Input</label>
                            <input type="text" class="form-control is-valid" id="validInput" value="Looks good!">
                            <div class="valid-feedback">Looks good!</div>
                        </div>
                        <div class="mb-3">
                            <label for="invalidInput" class="form-label">Invalid Input</label>
                            <input type="text" class="form-control is-invalid" id="invalidInput">
                            <div class="invalid-feedback">Please provide a valid input.</div>
                        </div>

                        <h3>Select</h3>
                        <div class="mb-3">
                            <label for="selectInput" class="form-label">Select</label>
                            <select class="form-select" id="selectInput">
                                <option selected>Choose...</option>
                                <option value="1">Option 1</option>
                                <option value="2">Option 2</option>
                                <option value="3">Option 3</option>
                            </select>
                        </div>

                        <h3>Textarea</h3>
                        <div class="mb-3">
                            <label for="textareaInput" class="form-label">Textarea</label>
                            <textarea class="form-control" id="textareaInput" rows="3"></textarea>
                        </div>

                        <h3>Checkboxes</h3>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="check1" checked>
                            <label class="form-check-label" for="check1">Checked checkbox</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="check2">
                            <label class="form-check-label" for="check2">Unchecked checkbox</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="check3" disabled>
                            <label class="form-check-label" for="check3">Disabled checkbox</label>
                        </div>

                        <h3>Radio Buttons</h3>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="radioGroup" id="radio1" checked>
                            <label class="form-check-label" for="radio1">Selected radio</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="radioGroup" id="radio2">
                            <label class="form-check-label" for="radio2">Unselected radio</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="radioGroup2" id="radio3" disabled>
                            <label class="form-check-label" for="radio3">Disabled radio</label>
                        </div>

                        <h3>Switches</h3>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="switch1" checked>
                            <label class="form-check-label" for="switch1">On switch</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="switch2">
                            <label class="form-check-label" for="switch2">Off switch</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="switch3" disabled>
                            <label class="form-check-label" for="switch3">Disabled switch</label>
                        </div>

                        <h3>Range</h3>
                        <div class="mb-3">
                            <label for="rangeInput" class="form-label">Range</label>
                            <input type="range" class="form-range" id="rangeInput">
                        </div>

                        <h3>Input Groups</h3>
                        <div class="input-group mb-3">
                            <span class="input-group-text">@@</span>
                            <input type="text" class="form-control" placeholder="Username">
                        </div>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Amount">
                            <span class="input-group-text">.00</span>
                        </div>
                        <div class="input-group mb-3">
                            <button class="btn btn-outline-secondary" type="button">Button</button>
                            <input type="text" class="form-control" placeholder="Search">
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cards -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cards">
                    Cards
                </button>
            </h2>
            <div id="cards" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Basic Card</h5>
                                    <p class="card-text">Simple card with body content.</p>
                                    <a href="#" class="btn btn-primary">Action</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-header">Card Header</div>
                                <div class="card-body">
                                    <h5 class="card-title">Card with Header</h5>
                                    <p class="card-text">Card with header section.</p>
                                </div>
                                <div class="card-footer text-muted">Card Footer</div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card text-white bg-primary">
                                <div class="card-body">
                                    <h5 class="card-title">Colored Card</h5>
                                    <p class="card-text">Primary colored card.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card border-success">
                                <div class="card-body text-success">
                                    <h5 class="card-title">Success Border</h5>
                                    <p class="card-text">Card with colored border.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card text-white bg-danger">
                                <div class="card-body">
                                    <h5 class="card-title">Danger Card</h5>
                                    <p class="card-text">Danger colored card.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card text-white bg-dark">
                                <div class="card-body">
                                    <h5 class="card-title">Dark Card</h5>
                                    <p class="card-text">Dark colored card.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tables -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tables">
                    Tables
                </button>
            </h2>
            <div id="tables" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <h3>Basic Table</h3>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>Item One</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Item Two</td>
                                <td><span class="badge bg-warning text-dark">Pending</span></td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>Item Three</td>
                                <td><span class="badge bg-danger">Inactive</span></td>
                            </tr>
                        </tbody>
                    </table>

                    <h3>Striped Table</h3>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Column 1</th>
                                <th>Column 2</th>
                                <th>Column 3</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Row 1</td><td>Data</td><td>More data</td></tr>
                            <tr><td>Row 2</td><td>Data</td><td>More data</td></tr>
                            <tr><td>Row 3</td><td>Data</td><td>More data</td></tr>
                        </tbody>
                    </table>

                    <h3>Hoverable & Bordered Table</h3>
                    <table class="table table-hover table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Column 1</th>
                                <th>Column 2</th>
                                <th>Column 3</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Row 1</td><td>Data</td><td>More data</td></tr>
                            <tr><td>Row 2</td><td>Data</td><td>More data</td></tr>
                            <tr class="table-primary"><td>Row 3</td><td>Primary row</td><td>More data</td></tr>
                        </tbody>
                    </table>

                    <h3>Table Colors</h3>
                    <table class="table">
                        <tbody>
                            <tr class="table-primary"><td>Primary row</td></tr>
                            <tr class="table-secondary"><td>Secondary row</td></tr>
                            <tr class="table-success"><td>Success row</td></tr>
                            <tr class="table-danger"><td>Danger row</td></tr>
                            <tr class="table-warning"><td>Warning row</td></tr>
                            <tr class="table-info"><td>Info row</td></tr>
                            <tr class="table-light"><td>Light row</td></tr>
                            <tr class="table-dark"><td>Dark row</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination & Breadcrumbs -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navigation">
                    Pagination & Breadcrumbs
                </button>
            </h2>
            <div id="navigation" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <h3>Pagination</h3>
                    <nav>
                        <ul class="pagination">
                            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>

                    <h3>Pagination Sizes</h3>
                    <nav>
                        <ul class="pagination pagination-lg">
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                        </ul>
                    </nav>
                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                        </ul>
                    </nav>

                    <h3>Breadcrumbs</h3>
                    <nav>
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item"><a href="#">Library</a></li>
                            <li class="breadcrumb-item active">Data</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Progress & Spinners -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#progress">
                    Progress Bars & Spinners
                </button>
            </h2>
            <div id="progress" class="accordion-collapse collapse" data-bs-parent="#componentAccordion">
                <div class="accordion-body">
                    <h3>Progress Bars</h3>
                    <div class="progress mb-3">
                        <div class="progress-bar" style="width: 25%">25%</div>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-success" style="width: 50%">50%</div>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-info" style="width: 75%">75%</div>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-warning" style="width: 100%">100%</div>
                    </div>

                    <h3>Striped & Animated Progress</h3>
                    <div class="progress mb-3">
                        <div class="progress-bar progress-bar-striped" style="width: 40%"></div>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 75%"></div>
                    </div>

                    <h3>Spinners</h3>
                    <div class="mb-3">
                        <div class="spinner-border text-primary me-2" role="status"></div>
                        <div class="spinner-border text-secondary me-2" role="status"></div>
                        <div class="spinner-border text-success me-2" role="status"></div>
                        <div class="spinner-border text-danger me-2" role="status"></div>
                        <div class="spinner-border text-warning me-2" role="status"></div>
                        <div class="spinner-border text-info me-2" role="status"></div>
                    </div>

                    <h3>Growing Spinners</h3>
                    <div class="mb-3">
                        <div class="spinner-grow text-primary me-2" role="status"></div>
                        <div class="spinner-grow text-secondary me-2" role="status"></div>
                        <div class="spinner-grow text-success me-2" role="status"></div>
                        <div class="spinner-grow text-danger me-2" role="status"></div>
                        <div class="spinner-grow text-warning me-2" role="status"></div>
                        <div class="spinner-grow text-info me-2" role="status"></div>
                    </div>
