@using TipsyBaboon.UI.Services
@using TipsyBaboon.Core
@using TipsyBaboon.Core.Interfaces
@using TipsyBaboon.UI.Configuration
@using TipsyBaboon.UI.Models
@using System.Security.Claims
@inject MenuBuilder MenuBuilder
@inject IPermissionService PermissionService

@{
    var config = ViewData["UIConfiguration"] as UIConfiguration ?? new UIConfiguration();
    var menu = await MenuBuilder.GetFilteredMenuAsync(PermissionService, config);
    var impersonationKey = User.FindFirst("ImpersonationKey")?.Value;
    var isImpersonating = !string.IsNullOrEmpty(impersonationKey);

    void RenderMenuItem(MenuItem item, bool isTopLevel = false)
    {
        if (!item.IsVisible)
        {
            return;
        }

        var hasChildren = item.Children.Any();

        <li class="nav-item">
            @if (item.Type == MenuItemType.Header)
            {
                <span class="nav-link menu-header">@item.Label</span>
            }
            else if (hasChildren)
            {
                <a href="#" class="nav-link" data-toggle="submenu">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon menu-icon"></i>
                    }
                    else
                    {
                        <span style="display: inline-block; width: 1.125rem; margin-right: 8px;"></span>
                    }
                    <span class="menu-title">@item.Label</span>
                    <i class="menu-arrow"></i>
                </a>
                <div class="submenu">
                    <ul>
                        @foreach (var child in item.Children.OrderBy(c => c.Order).ThenBy(c => c.Label))
                        {
                            RenderMenuItem(child, false);
                        }
                    </ul>
                </div>
            }
            else if (!string.IsNullOrEmpty(item.Url))
            {
                var activeClass = IsActive(item.Url) ? "active" : "";
                <a class="nav-link @activeClass" href="@item.Url" target="@item.Target" title="@item.Tooltip">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon menu-icon"></i>
                    }
                    else
                    {
                        <span style="display: inline-block; width: 1.125rem; margin-right: 8px;"></span>
                    }
                    <span class="menu-title">@item.Label</span>
                </a>
            }
            else
            {
                <span class="nav-link disabled">
                    <span class="menu-title">@item.Label</span>
                </span>
            }
        </li>
    }

    bool IsActive(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var currentPath = Context.Request.Path.ToString();
        return currentPath.StartsWith(url, StringComparison.OrdinalIgnoreCase);
    }
}

@* Impersonation warning banner *@
@if (isImpersonating)
{
    <li class="nav-item impersonation-banner">
        <div class="alert alert-warning mb-0 py-2 px-3 d-flex align-items-center justify-content-between">
            <span>
                <i class="bi bi-person-badge me-2"></i>
                <strong>Impersonating</strong> @User.Identity?.Name
            </span>
            <button type="button" class="btn btn-outline-dark" onclick="endImpersonation()">
                <i class="bi bi-box-arrow-left me-1"></i>End
            </button>
        </div>
    </li>
}

@* Render menu items only - consumer provides nav wrapper *@
@foreach (var item in menu.RootItems)
{
    RenderMenuItem(item, true);
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-toggle="submenu"]').forEach(function(toggle) {
            toggle.addEventListener('click', function(e) {
                e.preventDefault();
                var parent = this.parentElement;
                parent.classList.toggle('open');
            });
        });
    });

    async function endImpersonation() {
        try {
            const response = await fetch('/api/Governance/User/action/EndImpersonation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const result = await response.json();
            if (result.success) {
                window.location.reload();
            } else {
                alert(result.message || 'Failed to end impersonation');
            }
        } catch (error) {
            console.error('End impersonation error:', error);
            alert('Failed to end impersonation');
        }
    }
</script>
