@model TipsyBaboon.UI.Models.ForeignKeyLookupViewModel
@using TipsyBaboon.Core.Data
@using TipsyBaboon.Core.Interfaces
@using TipsyBaboon.UI.Configuration
@using TipsyBaboon.UI.Rendering

@inject IPermissionService PermissionService

@{
    var column = Model.Column;
    var elementId = Model.ElementId;
    var inputName = Model.InputName;
    var currentValue = Model.Value?.ToString() ?? "";
    var isReadOnly = ValidationHelper.IsReadOnly(column);
    var validationAttrs = ValidationHelper.FormatValidationAttributes(column);

    var relatedSchema = Model.RelatedSchema;
    var relatedModule = relatedSchema.ModuleName.Split('.').Last();
    var relatedType = relatedSchema.TypeName;
    var recordNameProp = relatedSchema.RecordNameProperty ?? "";
    var keyPropertyName = relatedSchema.KeyColumns.FirstOrDefault()?.PropertyName ?? "Id";
    var apiPrefix = TipsyBaboonUIOptions.ApiRoutePrefix;
    var pagePrefix = TipsyBaboonUIOptions.PageRoutePrefix;

    var permissions = await PermissionService.GetEffectivePermissionsForSchemaAsync(relatedSchema);
    var canCreate = permissions.CanCreate;
    var canEdit = permissions.CanUpdate;
}

<div class="tb-lookup" id="@(elementId)-lookup" 
     data-api-prefix="@apiPrefix" 
     data-module="@relatedModule" 
     data-type="@relatedType"
     data-record-name-prop="@recordNameProp"
     data-key-property="@keyPropertyName"
     data-page-prefix="@pagePrefix"
     data-enable-modal-view="@Model.EnableModalView.ToString().ToLowerInvariant()">
    <div class="input-group">
        <input type="text" 
               id="@(elementId)-display" 
               class="form-control tb-lookup-search" 
               placeholder="Search..." 
               autocomplete="off"
               value="@Model.DisplayValue"
               @(isReadOnly ? "readonly" : "") />
        <input type="hidden" 
               id="@elementId" 
               name="@inputName" 
               value="@currentValue" 
               @Html.Raw(validationAttrs) 
               @Html.Raw(Model.FieldContextAttribute) />
        @if (!isReadOnly && !string.IsNullOrEmpty(currentValue))
        {
            <button type="button" class="btn btn-outline-secondary tb-lookup-clear" title="Clear">
                <i class="bi bi-x-lg"></i>
            </button>
        }
        @if (canEdit && !isReadOnly)
        {
            <button type="button" class="btn btn-outline-secondary tb-lookup-edit" title="Edit" style="display: none;">
                <i class="bi bi-pencil"></i>
            </button>
        }
        @if (canCreate && !isReadOnly)
        {
            <button type="button" class="btn btn-outline-secondary tb-lookup-create" title="Create new">
                <i class="bi bi-plus-lg"></i>
            </button>
        }
    </div>
    <div class="dropdown-menu" style="display: none; position: absolute; max-height: 250px; overflow-y: auto;">
    </div>
</div>

<script>
(function () {
    const container = document.getElementById('@(elementId)-lookup');
    const searchInput = container.querySelector('.tb-lookup-search');
    const hiddenInput = document.getElementById('@elementId');
    const dropdown = container.querySelector('.dropdown-menu');
    const clearBtn = container.querySelector('.tb-lookup-clear');
    const editBtn = container.querySelector('.tb-lookup-edit');
    const createBtn = container.querySelector('.tb-lookup-create');

    const apiPrefix = container.dataset.apiPrefix;
    const module = container.dataset.module;
    const type = container.dataset.type;
    const pagePrefix = container.dataset.pagePrefix;
    const keyProperty = container.dataset.keyProperty;
    const enableModalView = container.dataset.enableModalView === 'true';
    const inputGroup = container.querySelector('.input-group');

    let debounceTimer = null;
    let selectedIndex = -1;
    let items = [];
    
    let originalKey = hiddenInput.value || '';
    let originalDisplay = searchInput.value || '';
    let isSearching = false;
    
    function UpdateDropdownWidth() {
        if (inputGroup) {
            dropdown.style.width = inputGroup.offsetWidth + 'px';
        }
    }

    function BuildEditUrl(key, isModal) {
        const prefix = pagePrefix ? '/' + pagePrefix : '';
        const url = prefix + '/' + module + '/' + type + '/' + encodeURIComponent(key);
        return isModal ? url + '?isModal=true' : url;
    }

    function BuildCreateUrl(isModal) {
        const prefix = pagePrefix ? '/' + pagePrefix : '';
        const url = prefix + '/' + module + '/' + type + '/Create';
        var params = [];
        if (isModal) params.push('isModal=true');
        params.push('isLookupCreate=true');
        return url + '?' + params.join('&');
    }

    function UpdateEditButton(key) {
        if (!editBtn) return;
        if (key) {
            editBtn.style.display = '';
        } else {
            editBtn.style.display = 'none';
        }
    }

    function ShowDropdown(results) {
        items = results;
        selectedIndex = -1;
        dropdown.innerHTML = '';
        UpdateDropdownWidth();

        if (results.length === 0) {
            dropdown.innerHTML = '<div class="dropdown-item disabled text-muted">No results found</div>';
            dropdown.style.display = 'block';
            return;
        }

        results.forEach(function (item, index) {
            const div = document.createElement('div');
            div.className = 'dropdown-item';
            div.style.cursor = 'pointer';
            div.textContent = item.Display;
            div.dataset.key = item.Key;
            div.dataset.index = index;

            div.addEventListener('mouseenter', function () {
                HighlightItem(index);
            });

            div.addEventListener('mousedown', function (e) {
                e.preventDefault();
                SelectItem(item);
            });

            dropdown.appendChild(div);
        });

        dropdown.style.display = 'block';
    }

    function HighlightItem(index) {
        const allItems = dropdown.querySelectorAll('.dropdown-item');
        allItems.forEach(function (el) { el.classList.remove('active'); });
        if (index >= 0 && index < allItems.length) {
            allItems[index].classList.add('active');
            selectedIndex = index;
        }
    }

    function SelectItem(item) {
        searchInput.value = item.Display;
        hiddenInput.value = item.Key;
        originalKey = item.Key;
        originalDisplay = item.Display;
        isSearching = false;
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
        dropdown.style.display = 'none';
        UpdateEditButton(item.Key);
        if (clearBtn) clearBtn.style.display = '';
    }

    function RevertToOriginal() {
        searchInput.value = originalDisplay;
        hiddenInput.value = originalKey;
        isSearching = false;
        UpdateEditButton(originalKey || null);
        if (clearBtn) clearBtn.style.display = originalKey ? '' : 'none';
    }

    function DoSearch(query) {
        const url = '/' + apiPrefix + '/' + module + '/' + type + '/lookup' +
            (query ? '?search=' + encodeURIComponent(query) : '');
        
        fetch(url, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (response) {
                if (response.Success && Array.isArray(response.Data)) {
                    ShowDropdown(response.Data);
                } else {
                    ShowDropdown([]);
                }
            })
            .catch(function () {
                ShowDropdown([]);
            });
    }

    function FetchRecordDisplay(key, callback) {
        const url = '/' + apiPrefix + '/' + module + '/' + type + '/lookup?search=';
        fetch(url, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (response) {
                if (response.Success && Array.isArray(response.Data)) {
                    const item = response.Data.find(function(i) { return i.Key == key; });
                    callback(item ? item.Display : key);
                } else {
                    callback(key);
                }
            })
            .catch(function () {
                callback(key);
            });
    }

    searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        isSearching = true;
        
        debounceTimer = setTimeout(function () {
            DoSearch(searchInput.value);
        }, 300);
    });

    searchInput.addEventListener('focus', function () {
        originalKey = hiddenInput.value || '';
        originalDisplay = searchInput.value || '';
        isSearching = true;
        
        searchInput.value = '';
        DoSearch('');
    });

    searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            e.preventDefault();
            dropdown.style.display = 'none';
            if (isSearching) {
                RevertToOriginal();
            }
            searchInput.blur();
            return;
        }

        if (dropdown.style.display === 'none') return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (selectedIndex < items.length - 1) HighlightItem(selectedIndex + 1);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (selectedIndex > 0) HighlightItem(selectedIndex - 1);
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (selectedIndex >= 0 && selectedIndex < items.length) {
                SelectItem(items[selectedIndex]);
            }
        }
    });

    searchInput.addEventListener('blur', function () {
        setTimeout(function () {
            dropdown.style.display = 'none';
            if (isSearching) {
                RevertToOriginal();
            }
        }, 200);
    });

    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            hiddenInput.value = '';
            originalKey = '';
            originalDisplay = '';
            isSearching = false;
            hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
            UpdateEditButton(null);
            clearBtn.style.display = 'none';
            searchInput.focus();
        });
    }

    if (editBtn) {
        editBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const key = hiddenInput.value;
            if (!key) return;
            
            if (enableModalView) {
                TipsyBaboon.UI.OpenModal(BuildEditUrl(key, true));
            } else {
                window.location.href = BuildEditUrl(key, false);
            }
        });
    }

    if (createBtn) {
        createBtn.addEventListener('click', function (e) {
            e.preventDefault();
            
            // Always use modal for create so we can capture the new record
            TipsyBaboon.UI.OpenModal(BuildCreateUrl(true), null, function(createdRecordData) {
                // Extract the key value using the schema's key property name
                var createdKey = createdRecordData && createdRecordData[keyProperty];
                if (createdKey) {
                    FetchRecordDisplay(createdKey, function(displayText) {
                        SelectItem({ Key: createdKey, Display: displayText });
                    });
                }
            });
        });
    }

    UpdateEditButton(hiddenInput.value || null);
})();
</script>
