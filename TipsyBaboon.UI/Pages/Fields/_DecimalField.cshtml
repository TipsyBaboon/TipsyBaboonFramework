@model TipsyBaboon.UI.Models.FieldViewModel<decimal?>
@using TipsyBaboon.UI.Rendering

@{
    var name = Model.Column.PropertyName;
    var elementId = Model.ElementId;
    var inputName = Model.InputName;
    var val = Model.Value?.ToString() ?? "";
    var isReadOnly = ValidationHelper.IsReadOnly(Model.Column);
    var validationAttrs = ValidationHelper.FormatValidationAttributes(Model.Column);
}

<input type="tel" id="@elementId" name="@inputName" value="@val" class="form-control" pattern="-?[0-9]*\.?[0-9]*" inputmode="decimal" @(isReadOnly ? "readonly" : "") @Html.Raw(validationAttrs) @Html.Raw(Model.FieldContextAttribute) />
