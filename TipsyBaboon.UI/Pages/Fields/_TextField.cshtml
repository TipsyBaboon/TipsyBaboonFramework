@model TipsyBaboon.UI.Models.FieldViewModel<string>
@using TipsyBaboon.UI.Rendering

@{
    var name = Model.Column.PropertyName;
    var elementId = Model.ElementId;
    var inputName = Model.InputName;
    var value = Model.Value ?? string.Empty;
    var isPassword = name.Contains("Password", StringComparison.OrdinalIgnoreCase);
    var inputType = isPassword ? "password" : "text";
    var isReadOnly = ValidationHelper.IsReadOnly(Model.Column);
    var validationAttrs = ValidationHelper.FormatValidationAttributes(Model.Column);
}

<input type="@inputType" id="@elementId" name="@inputName" value="@value" class="form-control" @(isReadOnly ? "readonly" : "") @Html.Raw(validationAttrs) @Html.Raw(Model.FieldContextAttribute) />