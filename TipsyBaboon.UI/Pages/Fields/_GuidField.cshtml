@model TipsyBaboon.UI.Models.FieldViewModel<Guid>
@using TipsyBaboon.UI.Rendering

@{
    var name = Model.Column.PropertyName;
    var elementId = Model.ElementId;
    var inputName = Model.InputName;
    var value = Model.Value.ToString();
    var validationAttrs = ValidationHelper.FormatValidationAttributes(Model.Column);
    var isReadOnly = name.Equals("Id", StringComparison.OrdinalIgnoreCase) || name.EndsWith("Id") || ValidationHelper.IsReadOnly(Model.Column);
}

<input type="text" id="@elementId" name="@inputName" value="@value" class="form-control" @(isReadOnly ? "readonly" : "") @Html.Raw(validationAttrs) @Html.Raw(Model.FieldContextAttribute) />